{
  "name": "syncline-server-node",
  "version": "0.1.0",
  "private": true,
  "description": "Node adapter for the sync server: node:sqlite storage, ws sockets, JWT edge — the local-dev and CI-parity runtime",
  "author": "Suvra Samajder",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "scripts": {
    "dev": "node --experimental-sqlite --import tsx src/main.ts"
  },
  "dependencies": {
    "@syncline/protocol": "workspace:*",
    "@syncline/server": "workspace:*",
    "syncline-demo-schema": "workspace:*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13",
    "tsx": "^4.20.4"
  }
}
